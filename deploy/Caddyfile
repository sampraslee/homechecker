# Home Check on a VPS with Caddy, which gets and renews the HTTPS certificate itself.
# Replace the address and root with the real ones; see docs/deploy.md.
home-check.example.com {
	root * /var/www/home-check
	file_server

	# Hashed file names, so they never change: cache for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html, sw.js, the manifest) must be checked on every load,
	# or phones keep running an old version of the app.
	@other not path /assets/*
	header @other Cache-Control "no-cache"
}
